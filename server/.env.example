# Copie ce fichier en ".env" (même dossier) et renseigne ta clé.
# Ne commite JAMAIS le fichier .env réel dans git.

ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3001

# ---- Boîte mail pro (OVH Zimbra) ----
# Paramètres officiels OVH (identiques pour Zimbra Starter/Pro et MX Plan) :
#   Serveur IMAP : ssl0.ovh.net, port 993 (SSL/TLS)
#   Serveur SMTP : ssl0.ovh.net, port 465 (SSL/TLS) ou 587 (STARTTLS)
# ⚠️ Le nom exact du serveur peut varier selon ton offre/cluster : vérifie dans
# l'espace client OVHcloud → Web Cloud → Zimbra Mail → [ton compte] → onglet
# "Configuration" pour l'adresse exacte si ssl0.ovh.net ne fonctionne pas.
MAIL_IMAP_HOST=ssl0.ovh.net
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=ssl0.ovh.net
MAIL_SMTP_PORT=465
MAIL_USER=contact@tondomaine.fr
MAIL_PASSWORD=le-mot-de-passe-de-cette-boite-mail
