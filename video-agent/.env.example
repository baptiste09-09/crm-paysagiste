# Copie ce fichier en .env puis renseigne ta clé (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel
# CLAUDE_MODEL=claude-opus-5-5
# VISION_MODEL=claude-opus-5-5     # analyse des images (ex. claude-haiku-5-5 pour diviser le coût)
# VIDEO_AGENT_HOME=~/VideoAgent    # proxys, exports (prévoir ~5 % de la taille des rushs)
# VIDEO_AGENT_PORT=8765
# VIDEO_AGENT_TOKEN=               # jeton fixe pour garder le même lien sur le téléphone
