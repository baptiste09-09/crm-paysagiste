# IA utilisée : "local" = gratuit (open source, sur le Mac via Ollama) ; "claude" = payant, meilleurs montages
IA_VISION=local
IA_MONTAGE=local

# Modèles locaux (optionnel, interchangeables : voir ollama.com/library)
# LOCAL_VISION_MODEL=qwen2.5vl:7b
# LOCAL_TEXT_MODEL=qwen2.5:7b        # qwen2.5:14b choisi automatiquement si le Mac a 32 Go de RAM ou plus
# LOCAL_MAX_CTX=32768

# Seulement si tu passes une des deux options en "claude" (console.anthropic.com > API keys)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# Optionnel
# VIDEO_AGENT_HOME=~/VideoAgent    # proxys, exports (prévoir ~5 % de la taille des rushs)
# VIDEO_AGENT_PORT=8765
